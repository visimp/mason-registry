{
  "$schema": "https://renovatebot.com",
  "extends": ["github>mason-org/registry-renovate-config"],
  "regexManagers": [
    {
      "fileMatch": ["packages\\.yaml$"],
      "matchStrings": [
        "\nname: (?<depName>.+)",
        "\n  id:\\s+pkg:hackage\\/(?<packageName>.+)@(?<currentValue>[^\\s\\?#]+)"
      ],
      "datasourceTemplate": "hackage"
    }
  ]
}
